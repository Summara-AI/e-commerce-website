``1`a# =============================================================================
# Korean Skin Lab — environment template
# Copy to `.env.local` and fill values. NEVER commit real secrets.
# =============================================================================
#
# LOCAL PREVIEW (seed catalog, no Shopify):
#   SHOPIFY_STOREFRONT_ENABLED=false
#   NEXT_PUBLIC_DEMO_COMMERCE=true
#   AUTH_PROVIDER=local
#   NEWSLETTER_PROVIDER=local
#
# PRODUCTION / STAGING (required before accepting paid orders):
#   SHOPIFY_STOREFRONT_ENABLED=true
#   NEXT_PUBLIC_DEMO_COMMERCE=false
#   AUTH_PROVIDER=shopify_storefront   (or Customer Account API when wired)
#   NEWSLETTER_PROVIDER=klaviyo|shopify_customers|shopify_email
#   Fill Shopify domain + Storefront token + payment/shipping in Admin
# =============================================================================

# --- App ---
NEXT_PUBLIC_SITE_URL=https://koreanskinlab.pk
NEXT_PUBLIC_SITE_NAME=Korean Skin Lab

# --- Shopify Storefront (server-only token) ---
# Keep false until Cart/Product transport is live and credentials are validated.
SHOPIFY_STOREFRONT_ENABLED=false
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2025-01

# Demo commerce heuristics (discounts / track-order / contact ack / preview checkout).
# MUST be false in production staging before go-live.
NEXT_PUBLIC_DEMO_COMMERCE=true

# Reviews provider for PDP: none | judgeme | loox | stamped | shopify
NEXT_PUBLIC_REVIEWS_PROVIDER=none

# Optional: override checkout handoff URL until Cart API returns cart.checkoutUrl
# Prefer cart.checkoutUrl in production — do not rely on a static cart URL.
# NEXT_PUBLIC_SHOPIFY_CHECKOUT_URL=https://your-store.myshopify.com/cart

# Optional Admin (server-only — webhook registration / metafield bootstrap apps)
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2025-01

# Customer Account API (headless auth) — future
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_URL=

# --- Images / CDN ---
# Prefer Shopify CDN + next/image. Optional custom image CDN host:
# NEXT_PUBLIC_IMAGE_CDN_HOST=

# --- Analytics (public IDs only — load after cookie consent) ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_PINTEREST_TAG_ID=
NEXT_PUBLIC_CLARITY_ID=

# --- Auth / Customer Accounts ---
# local | shopify_storefront
# local accepts demo credentials only — NEVER use for production orders.
# shopify_storefront uses Storefront customerAccessTokenCreate.
AUTH_PROVIDER=local
# AUTH_SESSION_COOKIE=ksl_customer_session

# --- Marketing / forms ---
# Newsletter provider: local | shopify_customers | shopify_email | klaviyo
# Swap provider / endpoints only — UI stays identical.
NEWSLETTER_PROVIDER=local

# Shopify Customers (Admin API — email marketing consent)
# Requires SHOPIFY_ADMIN_ACCESS_TOKEN + SHOPIFY_STORE_DOMAIN above.
# Optional override:
# SHOPIFY_CUSTOMERS_SUBSCRIBE_ENDPOINT=https://your-store.myshopify.com/admin/api/2025-01/graphql.json

# Shopify Email / Forms endpoint (App Proxy or custom handler)
# SHOPIFY_EMAIL_SUBSCRIBE_ENDPOINT=

# Klaviyo (server-only private key)
# KLAVIYO_PRIVATE_API_KEY=
# KLAVIYO_LIST_ID=
# KLAVIYO_PUBLIC_KEY=
# NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=
# Optional endpoint override:
# KLAVIYO_SUBSCRIBE_ENDPOINT=https://a.klaviyo.com/api/profile-subscription-bulk-create-jobs/

# RESEND_API_KEY=
# CONTACT_INBOX_EMAIL=

# --- Observability (future) ---
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=ttttttttttttttttttttttt   e   
